# Streamlit Secrets template. Choose ONE provider block and replace "...".
# Copy to .streamlit/secrets.toml for local use, or paste the chosen block into
# Streamlit Community Cloud -> App settings -> Secrets.
#
# Never commit .streamlit/secrets.toml or paste a real API key into chat.
# Private-app sharing/authentication is configured separately in Streamlit's
# Sharing settings; it does not provide an LLM API key.

# OpenAI
# LLM_PROVIDER = "openai"
# OPENAI_API_KEY = "..."
# LLM_MODEL = "gpt-4o-mini"

# Groq
# LLM_PROVIDER = "groq"
# GROQ_API_KEY = "..."
# LLM_MODEL = "openai/gpt-oss-120b"
# LLM_BASE_URL is optional because the Groq default is automatic

# Provider-neutral key alternative for either block:
# LLM_API_KEY = "..."

# Optional endpoint override. Usually leave this unset.
# LLM_BASE_URL = "https://your-compatible-endpoint/v1"
