# Streamlit secrets template.
#
# LOCAL USE:
#   Copy this file to ".streamlit/secrets.toml" (same folder, drop ".example")
#   and fill in your real key. That file is gitignored so it is never committed.
#
# STREAMLIT COMMUNITY CLOUD:
#   Do NOT upload this file. Instead paste these keys/values into the app's
#   Settings -> Secrets box in the Streamlit Cloud dashboard.

OPENAI_API_KEY = "sk-your-real-key-here"

# Optional: only if you use an OpenAI-compatible host instead of OpenAI.
# OPENAI_BASE_URL = "https://your-compatible-endpoint/v1"
